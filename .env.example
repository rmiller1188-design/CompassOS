# Public application origin. Use HTTPS outside local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project API settings. The service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: npm run secrets
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# Separate Google OAuth Web application for Gmail/Calendar/Contacts data access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Separate Microsoft Entra Web application for Mail/Calendar/Contacts data access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Optional. The app works without AI briefs when this is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
